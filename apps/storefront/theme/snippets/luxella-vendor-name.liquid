{%- comment -%}
  Luxella: display name for a product vendor.
  Scraped vendors are often run together ("Karllagerfeld", "Jwpei"). This maps the known ones to the brand's
  real name and leaves everything else unchanged. Add a line when a new site is onboarded.

  Accepts:
  - vendor {String}: product.vendor
  Usage: {% render 'luxella-vendor-name', vendor: product.vendor %}
{%- endcomment -%}
{%- liquid
  assign key = vendor | downcase | strip
  case key
    when 'karllagerfeld'
      echo 'Karl Lagerfeld'
    when 'jwpei'
      echo 'JW PEI'
    when 'aloyoga'
      echo 'Alo Yoga'
    when 'cultgaia'
      echo 'Cult Gaia'
    when 'loefflerrandall'
      echo 'Loeffler Randall'
    when 'polene'
      echo 'Polène'
    when 'staud'
      echo 'Staud'
    when 'katespade'
      echo 'Kate Spade'
    when 'michaelkors'
      echo 'Michael Kors'
    when 'marcjacobs'
      echo 'Marc Jacobs'
    when 'toryburch'
      echo 'Tory Burch'
    when 'ralphlauren'
      echo 'Ralph Lauren'
    when 'verabradley'
      echo 'Vera Bradley'
    when 'victoriabeckham'
      echo 'Victoria Beckham'
    when 'vincecamuto'
      echo 'Vince Camuto'
    when 'stevemadden'
      echo 'Steve Madden'
    when 'simonmiller'
      echo 'Simon Miller'
    when 'mansurgavriel'
      echo 'Mansur Gavriel'
    when 'goodamerican'
      echo 'Good American'
    when 'francesvalentine'
      echo 'Frances Valentine'
    when 'cambridgesatchel'
      echo 'Cambridge Satchel'
    when 'aimeekestenberg'
      echo 'Aimee Kestenberg'
    when 'littleliffner'
      echo 'Little Liffner'
    when 'beyondyoga'
      echo 'Beyond Yoga'
    when 'ilovedooney'
      echo 'Dooney & Bourke'
    when 'hobobags'
      echo 'HOBO'
    when 'ninashoes'
      echo 'Nina'
    when 'landsend'
      echo "Lands' End"
    when 'stanley1913'
      echo 'Stanley'
    when 'secretsales'
      echo 'Secret Sales'
    when 'demellier'
      echo 'DeMellier'
    when 'carmensol'
      echo 'Carmen Sol'
    when 'penation'
      echo 'P.E Nation'
    when 'mcm'
      echo 'MCM'
    when 'kaws'
      echo 'KAWS'
    when 'awake ny'
      echo 'Awake NY'
    when 'asos design'
      echo 'ASOS DESIGN'
    when "arc'teryx"
      echo "Arc'teryx"
    when 'eadem'
      echo 'EADEM'
    when 'nagnata'
      echo 'NAGNATA'
    when 'cosrx'
      echo 'COSRX'
    when 'anua'
      echo 'ANUA'
    when 'fear of god essentials'
      echo 'Fear of God Essentials'
    when 'fear of god'
      echo 'Fear of God'
    when 'adidas'
      echo 'adidas'
    else
      echo vendor
  endcase
-%}
