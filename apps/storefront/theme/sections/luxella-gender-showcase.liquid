{%- comment -%}
  Luxella gender showcase: search, MEN/WOMEN switch, hero, brand circles, category tabs and a product rail.
  Spec: docs/specs/2026-10-17-gender-showcase-homepage.md

  Blocks (all set in the theme editor):
  - gender: one per audience (max 2). Its "key" links it to brand and tab blocks.
  - brand:  circle linking to a collection, or to a vendor via Shopify's /collections/vendors?q= page.
  - tab:    category tab for a collection or a vendor. The first tab of each gender is rendered here;
            the others load on click from sections/luxella-showcase-rail.liquid (Section Rendering API).
{%- endcomment -%}
{{ 'luxella-showcase.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'quick-add.css' | asset_url }}" media="print" onload="this.media='all'">
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'luxella-showcase.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign genders = section.blocks | where: 'type', 'gender'
  assign brands = section.blocks | where: 'type', 'brand'
  assign tabs = section.blocks | where: 'type', 'tab'
  assign first_gender = genders.first

  assign blackletter_text = ''
  for g in genders
    if g.settings.heading_style == 'blackletter'
      assign blackletter_text = blackletter_text | append: g.settings.heading | append: g.settings.accent
    endif
  endfor
-%}

{%- if blackletter_text != blank -%}
  {%- comment -%} Only the hero's own letters are downloaded (Google Fonts `text=` subset). UnifrakturMaguntia is SIL OFL. {%- endcomment -%}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap&text={{ blackletter_text | url_encode }}"
  >
{%- endif -%}

{%- style -%}
  .lx-showcase--{{ section.id }} {
    --lx-pt: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    --lx-pb: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .lx-showcase--{{ section.id }} {
      --lx-pt: {{ section.settings.padding_top }}px;
      --lx-pb: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<lx-showcase
  class="lx-showcase lx-showcase--{{ section.id }}"
  data-theme="{{ first_gender.settings.theme | default: 'dark' }}"
  data-gender="{{ first_gender.settings.key }}"
  data-rail-section="luxella-showcase-rail"
>
  <div class="lx-showcase__inner">
    {%- if section.settings.show_search -%}
      <div class="lx-search">
        {%- if settings.predictive_search_enabled -%}
          <predictive-search class="lx-search__ps" data-loading-text="{{ 'accessibility.loading' | t }}">
        {%- else -%}
          <search-form class="lx-search__ps">
        {%- endif -%}
        <form action="{{ routes.search_url }}" method="get" role="search" class="lx-search__form">
          <label class="visually-hidden" for="LxSearch-{{ section.id }}">{{ 'general.search.search' | t }}</label>
          <span class="lx-search__icon" aria-hidden="true">{{- 'icon-search.svg' | inline_asset_content -}}</span>
          <input
            class="lx-search__input"
            id="LxSearch-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder | escape }}"
            {%- if settings.predictive_search_enabled -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results"
              aria-controls="predictive-search-results"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="reset" class="lx-search__reset hidden" aria-label="{{ 'general.search.reset' | t }}">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </button>
          {%- if settings.predictive_search_enabled -%}
            <div class="predictive-search lx-search__results" tabindex="-1" data-predictive-search>
              {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
            </div>
            <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
          {%- endif -%}
        </form>
        {%- if settings.predictive_search_enabled -%}
          </predictive-search>
        {%- else -%}
          </search-form>
        {%- endif -%}

        {%- if section.settings.wishlist_page != blank -%}
          <a href="{{ section.settings.wishlist_page.url }}" class="lx-saved" aria-label="Saved pieces">
            <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
              <path d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z"/>
            </svg>
            <span class="lx-saved__count" data-lx-wish-count hidden></span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if genders.size > 1 -%}
      <div class="lx-switch" role="group" aria-label="Shop for">
        {%- for g in genders -%}
          <button
            type="button"
            class="lx-switch__btn"
            data-lx-gender="{{ g.settings.key }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-controls="LxPanel-{{ section.id }}-{{ g.settings.key }}"
          >
            {{- g.settings.label | escape -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for g in genders -%}
      {%- assign key = g.settings.key -%}
      {%- assign is_first_gender = forloop.first -%}
      <div
        class="lx-panel"
        id="LxPanel-{{ section.id }}-{{ key }}"
        data-lx-panel="{{ key }}"
        data-theme="{{ g.settings.theme }}"
        {% unless forloop.first %}
          hidden
        {% endunless %}
        {{ g.shopify_attributes }}
      >
        <div class="lx-hero">
          <h2 class="lx-hero__title lx-hero__title--{{ g.settings.heading_style }}">
            {{- g.settings.heading | escape -}}
            {%- if g.settings.accent != blank %} <span class="lx-hero__accent">{{ g.settings.accent | escape }}</span>{% endif -%}
          </h2>
          {%- if g.settings.subtitle != blank -%}
            <p class="lx-hero__sub">{{ g.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>

        {%- capture brand_items -%}
          {%- for b in brands -%}
            {%- if b.settings.gender == key -%}
              {%- liquid
                assign b_url = blank
                assign b_label = b.settings.label
                if b.settings.collection != blank
                  assign b_url = b.settings.collection.url
                  if b_label == blank
                    assign b_label = b.settings.collection.title
                  endif
                elsif b.settings.vendor != blank
                  assign b_url = b.settings.vendor | url_for_vendor
                  if b_label == blank
                    assign b_label = b.settings.vendor
                  endif
                endif
                assign b_img = b.settings.image | default: b.settings.collection.image
              -%}
              {%- if b_url != blank -%}
                <li class="lx-brand" {{ b.shopify_attributes }}>
                  <a href="{{ b_url }}" class="lx-brand__link">
                    <span class="lx-brand__circle">
                      {%- if b_img != blank -%}
                        {{
                          b_img
                          | image_url: width: 176, height: 176, crop: 'center'
                          | image_tag: loading: 'lazy', alt: '', class: 'lx-brand__img', width: 88, height: 88
                        }}
                      {%- else -%}
                        <span class="lx-brand__word{% if b_label.size > 9 %} lx-brand__word--long{% endif %}">
                          {{- b_label | escape -}}
                        </span>
                      {%- endif -%}
                    </span>
                    {%- if b_img != blank -%}
                      <span class="lx-brand__name">{{ b_label | escape }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if brand_items != blank -%}
          <ul class="lx-brands" role="list" aria-label="{{ g.settings.label | escape }} brands">
            {{- brand_items -}}
          </ul>
        {%- endif -%}

        {%- assign n = 0 -%}
        {%- capture tab_buttons -%}
          {%- for t in tabs -%}
            {%- if t.settings.gender == key -%}
              {%- liquid
                assign t_url = blank
                assign t_label = t.settings.label
                if t.settings.collection != blank
                  assign t_url = t.settings.collection.url
                  if t_label == blank
                    assign t_label = t.settings.collection.title
                  endif
                elsif t.settings.vendor != blank
                  assign t_url = t.settings.vendor | url_for_vendor
                  if t_label == blank
                    assign t_label = t.settings.vendor
                  endif
                endif
              -%}
              {%- if t_url != blank -%}
                {%- assign n = n | plus: 1 -%}
                <button
                  type="button"
                  role="tab"
                  class="lx-tab"
                  id="LxTab-{{ t.id }}"
                  aria-controls="LxTabPanel-{{ t.id }}"
                  aria-selected="{% if n == 1 %}true{% else %}false{% endif %}"
                  tabindex="{% if n == 1 %}0{% else %}-1{% endif %}"
                  {{ t.shopify_attributes }}
                >
                  {{- t_label | escape -}}
                </button>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- if n > 0 -%}
          <div class="lx-tabs-row">
            <div class="lx-tabs" role="tablist" aria-label="{{ g.settings.label | escape }} categories">
              {{- tab_buttons -}}
            </div>
            <div class="lx-arrows">
              <button type="button" class="lx-arrow" data-lx-scroll="-1" aria-label="{{ 'general.slider.previous_slide' | t }}">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </button>
              <button type="button" class="lx-arrow lx-arrow--next" data-lx-scroll="1" aria-label="{{ 'general.slider.next_slide' | t }}">
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </button>
            </div>
          </div>

          {%- assign m = 0 -%}
          {%- for t in tabs -%}
            {%- if t.settings.gender == key -%}
              {%- liquid
                assign t_url = blank
                assign t_label = t.settings.label
                if t.settings.collection != blank
                  assign t_url = t.settings.collection.url
                  if t_label == blank
                    assign t_label = t.settings.collection.title
                  endif
                elsif t.settings.vendor != blank
                  assign t_url = t.settings.vendor | url_for_vendor
                  if t_label == blank
                    assign t_label = t.settings.vendor
                  endif
                endif
              -%}
              {%- if t_url != blank -%}
                {%- assign m = m | plus: 1 -%}
                {%- assign rendered_here = false -%}
                {%- if m == 1 and t.settings.collection != blank -%}
                  {%- assign rendered_here = true -%}
                {%- endif -%}
                <div
                  class="lx-tabpanel"
                  role="tabpanel"
                  id="LxTabPanel-{{ t.id }}"
                  aria-labelledby="LxTab-{{ t.id }}"
                  data-lx-src="{{ t_url }}"
                  {% if rendered_here %}
                    data-lx-loaded
                  {% endif %}
                  {% if m > 1 %}
                    hidden
                  {% endif %}
                >
                  <div class="lx-rail-wrap" data-lx-rail-wrap>
                    {%- if rendered_here -%}
                      {%- liquid
                        assign eager = false
                        if is_first_gender and section.index == 1
                          assign eager = true
                        endif
                      -%}
                      {% render 'luxella-showcase-rail',
                        products: t.settings.collection.products,
                        id_prefix: t.id,
                        section_id: section.id,
                        eager: eager
                      %}
                    {%- else -%}
                      <ul class="lx-rail lx-rail--skeleton" aria-hidden="true">
                        {%- for i in (1..4) -%}
                          <li class="lx-card lx-card--skeleton"><div class="lx-card__frame"></div><span></span><span></span></li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}
                  </div>
                  <a href="{{ t_url }}" class="lx-viewall">View all {{ t_label | escape }}</a>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    {%- endfor -%}

    <p class="visually-hidden" data-lx-live role="status" aria-live="polite"></p>
  </div>

  <script>
    {%- comment -%} Apply the saved MEN/WOMEN choice before first paint, so the page does not flash the default. {%- endcomment -%}
    (function () {
      try {
        var root = document.currentScript.closest('lx-showcase');
        var key = localStorage.getItem('luxella:gender');
        var panel = key && root.querySelector('[data-lx-panel="' + key + '"]');
        if (!panel || key === root.dataset.gender) return;
        root.querySelectorAll('[data-lx-panel]').forEach(function (p) { p.hidden = p !== panel; });
        root.querySelectorAll('[data-lx-gender]').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.lxGender === key));
        });
        root.dataset.gender = key;
        root.dataset.theme = panel.dataset.theme;
      } catch (e) {}
    })();
  </script>
</lx-showcase>

{% schema %}
{
  "name": "Luxella gender showcase",
  "tag": "section",
  "class": "section lx-showcase-section",
  "max_blocks": 50,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search bar",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search brands, bags, sneakers"
    },
    {
      "type": "page",
      "id": "wishlist_page",
      "label": "Wishlist page",
      "info": "A page using the 'wishlist' template. When set, a heart link with the saved count appears next to search."
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "gender",
      "name": "Audience (Men / Women)",
      "limit": 2,
      "settings": [
        {
          "type": "select",
          "id": "key",
          "label": "Audience",
          "info": "Brand and tab blocks with the same audience show under this switch.",
          "options": [
            { "value": "men", "label": "Men" },
            { "value": "women", "label": "Women" }
          ],
          "default": "men"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Switch label",
          "default": "MEN"
        },
        {
          "type": "select",
          "id": "theme",
          "label": "Look",
          "options": [
            { "value": "dark", "label": "Near-black" },
            { "value": "ivory", "label": "Warm ivory" }
          ],
          "default": "dark"
        },
        {
          "type": "select",
          "id": "heading_style",
          "label": "Heading font",
          "options": [
            { "value": "blackletter", "label": "Blackletter" },
            { "value": "serif_italic", "label": "Serif italic" },
            { "value": "serif", "label": "Serif" }
          ],
          "default": "blackletter"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "The Collector's Den"
        },
        {
          "type": "text",
          "id": "accent",
          "label": "Accent words",
          "info": "Shown after the heading in champagne brass. Optional."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subheading",
          "info": "Only claims the store can honour. No discounts or delivery promises.",
          "default": "Sourced from the world's finest houses."
        }
      ]
    },
    {
      "type": "brand",
      "name": "Brand circle",
      "settings": [
        {
          "type": "select",
          "id": "gender",
          "label": "Audience",
          "options": [
            { "value": "men", "label": "Men" },
            { "value": "women", "label": "Women" }
          ],
          "default": "women"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Brand collection"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Or vendor name",
          "info": "Used when no collection is set. Links to Shopify's vendor page, e.g. Nike."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the collection title or vendor."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo or image",
          "info": "Only use artwork Luxella is licensed to show. Without one, the brand name is set in type."
        }
      ]
    },
    {
      "type": "tab",
      "name": "Category tab",
      "settings": [
        {
          "type": "select",
          "id": "gender",
          "label": "Audience",
          "options": [
            { "value": "men", "label": "Men" },
            { "value": "women", "label": "Women" }
          ],
          "default": "women"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Tab label",
          "info": "Defaults to the collection title or vendor."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "vendor",
          "label": "Or vendor name",
          "info": "Used when no collection is set."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxella gender showcase",
      "blocks": [
        {
          "type": "gender",
          "settings": { "key": "men", "label": "MEN", "theme": "dark", "heading_style": "blackletter" }
        },
        {
          "type": "gender",
          "settings": {
            "key": "women",
            "label": "WOMEN",
            "theme": "ivory",
            "heading_style": "serif_italic",
            "heading": "Edited",
            "accent": "for her."
          }
        }
      ]
    }
  ]
}
{% endschema %}
